# 70-waleattack.rules
# Permissões de acesso aos nós /dev/hidraw* para hardware WaleAttack (VID 1d57 / 248a)
# Compatível universalmente com distros systemd (TAG+="uaccess") e alternativas (MODE="0666").

# Receptor Wireless 2.4G e Conexão via Cabo USB (VID 1d57)
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1d57", MODE="0666", TAG+="uaccess"

# Firmware OEM alternativo Beken (VID 248a)
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="248a", MODE="0666", TAG+="uaccess"
